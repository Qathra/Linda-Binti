<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-only cleartext policy for physical-device LAN testing.
  Release continues to use src/main (cleartext denied by default).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.100.11</domain>
        <domain includeSubdomains="true">192.168.100.44</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
