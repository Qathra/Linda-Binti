<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false in the manifest is the primary control. These excludes are defense-in-depth. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="linda_secure_prefs.xml" />
    <exclude domain="database" path="." />
    <exclude domain="database" path="linda_binti.db" />
    <exclude domain="database" path="linda_binti.db-shm" />
    <exclude domain="database" path="linda_binti.db-wal" />
    <exclude domain="file" path="." />
</full-backup-content>
