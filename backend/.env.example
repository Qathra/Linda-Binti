# Linda Binti backend — copy to backend/.env (NEVER commit real keys).
# Online AI uses an OpenAI-compatible API. Offline rules AI always remains available.

LINDA_AI_ENABLED=1
LINDA_AI_API_KEY=your-server-side-key-here
LINDA_AI_BASE_URL=https://api.openai.com
LINDA_AI_MODEL=gpt-4o-mini
LINDA_AI_TIMEOUT_MS=8000
LINDA_AI_MAX_RETRIES=1

# Optional server bind (default 0.0.0.0:8080 for phone + web dashboard)
# LINDA_HOST=0.0.0.0
# LINDA_PORT=8080

# Optional live integration test (gradle :backend:test -DLINDA_AI_LIVE_TEST=1)
# LINDA_AI_LIVE_TEST=1

# LINDA_DEMO_SEED=1  # force panel demo map data; auto-seeds when DB is empty
# LINDA_DEMO_SEED=0  # disable demo seed entirely (production)

# Live USSD (Africa's Talking). Empty = stub.
# LINDA_USSD_GATEWAY_SECRET=
# Optional alias if gateway secret unset:
# LINDA_USSD_AT_API_KEY=

# Web NGO dashboard (local dev): http://127.0.0.1:8080/dashboard/
# Production (after deploy + DNS): https://lindabinti.com/dashboard/
# Phone debug backend URL: app/build.gradle.kts debug buildConfigField
# Phone production URL: https://lindabinti.com/ (release build)
# LINDA_PUBLIC_URL=https://lindabinti.com
