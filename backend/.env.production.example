# Production server — set these in your cloud host (Render, Railway, VPS).
# Public site: https://lindabinti.com/dashboard/
# NEVER commit real secrets.

LINDA_ENV=production
LINDA_PUBLIC_URL=https://lindabinti.com
LINDA_HOST=0.0.0.0
# Cloud hosts often set PORT automatically; LINDA_PORT is used if PORT is unset.
LINDA_PORT=8080

LINDA_DB_URL=jdbc:sqlite:/var/data/linda_binti_backend.db
LINDA_JWT_SECRET=generate-a-long-random-secret-at-least-32-chars

# Required for live Africa's Talking / gateway USSD (set in host secrets).
LINDA_USSD_GATEWAY_SECRET=generate-a-long-random-ussd-gateway-secret

# Disable panel demo map/education auto-seed in production.
LINDA_DEMO_SEED=0

LINDA_SEED_ADMIN_EMAIL=admin@lindabinti.com
# Set a strong password on first deploy, or run admin reset once via SSH.
# LINDA_SEED_ADMIN_PASSWORD=

LINDA_AI_ENABLED=1
LINDA_AI_API_KEY=your-server-side-key-here
LINDA_AI_BASE_URL=https://api.openai.com
LINDA_AI_MODEL=gpt-4o-mini
